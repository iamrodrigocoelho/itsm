NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
DB_USER=itsm_user
DB_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://itsm_user:change_me_strong_password@postgres:5432/itsm

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_256bit_hex_string
JWT_REFRESH_SECRET=replace_with_another_random_256bit_hex_string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=28800

# ─── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.empresa.com.br
SMTP_PORT=587
SMTP_USER=no-reply@empresa.com.br
SMTP_PASSWORD=change_me_smtp_password
SMTP_FROM="ITSM Conexão Tech <no-reply@empresa.com.br>"
SMTP_TLS=true

# ─── CASI API (Conexão Tech) ────────────────────────────────────────────────────
CASI_BASE_URL=https://api.conexaotech.com.br
CASI_TENANT_ID=your-azure-tenant-id
CASI_CLIENT_ID=your-azure-client-id
CASI_CLIENT_SECRET=your-azure-client-secret
CASI_SCOPE=https://graph.microsoft.com/.default
CASI_AUTH_KEY_REST_API=your-auth-key-provided-by-conexao-tech
CASI_SUBSCRIPTION_KEY=your-ocp-apim-subscription-key
CASI_DEFAULT_COD_DOMINIO=1

# ─── Application ───────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost
APP_PORT=3000
LOG_LEVEL=info

# ─── Admin seed (only used on first startup) ──────────────────────────────────
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_MATRICULA=000001
SEED_ADMIN_NOME=Administrador do Sistema
